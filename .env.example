# Feature flags (default true if omitted)
FEATURE_LZV_SCRAPE=true
FEATURE_ICAL_SYNC=true
FEATURE_PUSH=true
FEATURE_BACKUP=true
FEATURE_LOGS=true

# HTTP
PORT=3001
TIMEZONE=Europe/Brussels

# Supabase API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Supabase Database Backup Configuration (for pg_dump)
# Get these from Supabase Dashboard > Database > Connection string
SUPABASE_DB_HOST=db.your-project.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-db-password

# Backup retention (days) - default 90 days (3 months)
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=90
LOG_DIR=/logs

# iCal feeds. Either set explicit calendar URL(s), or a template with {id}
# filled from core_teams.lzv_external_id.
# ICAL_URL=https://www.lzvcup.be/icalendar.php?id=1319
# ICAL_URLS=https://example.com/team-a.ics,https://example.com/team-b.ics
ICAL_URL_TEMPLATE=https://www.lzvcup.be/icalendar.php?id={id}

# LZV scraper site (only used when FEATURE_LZV_SCRAPE=true)
LZV_BASE_URL=https://www.lzvcup.be

# Cloudflare Web Push worker
PUSH_FLUSH_URL=https://your-push-worker.example.workers.dev/flush
PUSH_ENQUEUE_URL=https://your-push-worker.example.workers.dev/enqueue
PUSH_FLUSH_SECRET=your-push-flush-secret
PUSH_APP_ORIGIN=https://your-app.example.com
